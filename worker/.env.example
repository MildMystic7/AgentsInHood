# AgentsInHood worker
# Copy to .env locally. Store production values in Railway Variables.

KV_REST_API_URL=
KV_REST_API_TOKEN=
# Railway Redis can be used instead of the Upstash REST pair.
REDIS_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Robinhood Chain mainnet. Begin in dry-run and inspect /mainnet/status.
MAINNET_MODE=dry-run
MAINNET_RUN_ID=
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
MAINNET_PRIVATE_KEY=
MAINNET_WALLET_ADDRESS=
UNISWAP_API_KEY=

# Real-money circuit breakers. Values are whole US cents.
MAINNET_MAX_TRADE_USD_CENTS=5
MAINNET_DAILY_BUDGET_USD_CENTS=1000
MAINNET_TOTAL_BUDGET_USD_CENTS=200
MAINNET_MAX_GAS_USD_CENTS=5
MAINNET_DAILY_GAS_BUDGET_USD_CENTS=50
MAINNET_TOTAL_GAS_BUDGET_USD_CENTS=100
MAINNET_MIN_GAS_RESERVE_ETH=0.001
MAINNET_MIN_SECONDS_BETWEEN_TRADES=600
MAINNET_MAX_PRICE_IMPACT_PERCENT=10
MAINNET_SLIPPAGE_PERCENT=10

# Optional public audit recovery for confirmed records evicted by an older
# worker version. JSON array only; never place secrets in this value.
MAINNET_AUDIT_TRADES_JSON=

# Deliberately absent by default. Required verbatim before live transactions.
# MAINNET_LIVE_CONFIRM=I_UNDERSTAND_REAL_FUNDS
