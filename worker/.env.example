# ── AlphaHood worker — environment ───────────────────────────────────────────
# Copy to .env for local runs. On Railway, set these as service Variables.

# Shared with the main site's KV store (Vercel Storage → the Upstash for Redis
# integration) — same values, so this worker's portfolio state persists across
# restarts and stays separate from the main site's own keys.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegram — same bot/chat as the main site's notifications (copy the values
# from Vercel; Railway doesn't share env vars with Vercel automatically).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── On-chain ledger (Base Sepolia testnet — zero real value) ────────────────
# Generate with `npm run new-wallet`. TESTNET ONLY — never put a mainnet key
# here, and never fund this address with real assets.
WORKER_PRIVATE_KEY=
# Set after `npm run deploy` prints the deployed address.
LEDGER_CONTRACT_ADDRESS=
# Public, keyless Base Sepolia RPC. Override if you have your own (Alchemy/
# Infura) for higher reliability.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
