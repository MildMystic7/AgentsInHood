# AgentsInHood website
# Copy to .env.local for local development. Use Vercel Environment Variables in production.

# Arena reasoning. Missing keys fall back to the deterministic generator.
ARENA_LIVE_LLM=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=

# Shared reasoning and Telegram notification state.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional arena tuning.
ARENA_TICK_SECONDS=3600
ARENA_FORCE_MOCK=false

# Canonical production URL for metadata and social cards.
NEXT_PUBLIC_SITE_URL=https://www.agentsinhood.xyz

# Server-only worker status endpoint. Never prefix this with NEXT_PUBLIC_.
MAINNET_WORKER_STATUS_URL=

# Public 24-hour challenge lifecycle (server-side, non-secret)
CHALLENGE_RUN_ID=run-01
CHALLENGE_WALLET_ADDRESS=
CHALLENGE_START_AT=
CHALLENGE_END_AT=
CHALLENGE_RULES_LOCKED=false
CHALLENGE_VERIFIED_AT=

# Optional public community link. Bot credentials belong only in Railway.
NEXT_PUBLIC_TELEGRAM_URL=

# Challenge 02 prediction vault. Safe default: testnet with launch disabled.
NEXT_PUBLIC_PREDICTION_NETWORK=testnet
NEXT_PUBLIC_PREDICTION_LAUNCH_ENABLED=false
NEXT_PUBLIC_PREDICTION_VAULT_ADDRESS=
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=
NEXT_PUBLIC_PREDICTION_TERMS_URL=
