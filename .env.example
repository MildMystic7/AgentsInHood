# ─────────────────────────────────────────────────────────────────────────────
# Alpha Arena — environment
# Copy this file to `.env.local` and fill in whichever keys you have.
#
# With ARENA_LIVE_LLM=true, the agents' latest reasoning is generated by REAL
# LLM APIs. Any missing key (or any API failure) falls back to the built-in
# deterministic reasoning generator, so the site ALWAYS runs.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch for real-LLM reasoning (local demos and/or production).
ARENA_LIVE_LLM=false

# Anthropic  → powers "Claude Opus 4.8" and "Fable 5"  (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI     → powers the "GPT" agent       (https://platform.openai.com/)
OPENAI_API_KEY=

# Google     → powers the "Gemini" agent    (https://aistudio.google.com/)
GOOGLE_API_KEY=

# MiniMax    → powers the "MiniMax" agent    (OpenAI-compatible endpoint)
MINIMAX_API_KEY=

# ── Production only: shared reasoning store (Vercel KV / Upstash Redis) ──────
# Required for ARENA_LIVE_LLM=true on Vercel so every serverless instance shows
# the SAME reasoning. Create a KV store in the Vercel dashboard (Storage → KV,
# connect to the project) and these two vars are injected automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Simulation tuning (optional) ──────────────────────────────────────────────
# Seconds of real time per simulated "hour". Lower = faster leaderboard action.
ARENA_TICK_SECONDS=10
# Force the built-in reasoning generator even if API keys are present (offline demo).
ARENA_FORCE_MOCK=false
# Canonical site URL used in Open Graph / Twitter card metadata.
NEXT_PUBLIC_SITE_URL=https://AgentsInHood.vercel.app

# ── Telegram trade notifications ──────────────────────────────────────────────
# Sends new trades (Order Flow) + the reasoning behind them (AI Reasoning) to a
# Telegram chat/channel as they happen. See docs/TELEGRAM_SETUP.md for the full
# walkthrough (BotFather, chat id, GitHub Action). Requires KV_REST_API_URL/
# TOKEN above (used to remember what's already been sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret the GitHub Action sends so randoms on the internet can't spam
# your bot by hitting /api/notify/telegram directly. Any long random string.
NOTIFY_SECRET=
# Optional: shown as a "Follow on Telegram" link in the footer once you have a
# public channel invite link. Left blank, the link simply doesn't render.
NEXT_PUBLIC_TELEGRAM_URL=
